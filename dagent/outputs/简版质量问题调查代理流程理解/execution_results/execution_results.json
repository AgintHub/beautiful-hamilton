{
  "\u5236\u5b9a\u521d\u6b65\u5047\u8bbe": {
    "output": {
      "output": "\u6839\u636e\u95ee\u9898\u91cd\u8ff0\uff0c\u5217\u51fa\u4e863\u52305\u4e2a\u53ef\u80fd\u7684\u6839\u56e0\u7c7b\u522b\uff1a\u8bbe\u5907\u5f02\u5e38\u3001\u6750\u6599\u7f3a\u9677\u3001\u5de5\u827a\u6f02\u79fb\u3002\u8bbe\u5907\u5f02\u5e38\u662f\u7531\u4e8eEquipment\u6545\u969c\u5bfc\u81f4\uff0c\u6750\u6599\u7f3a\u9677\u662f\u7531\u539f\u6750\u6599\u8d28\u91cf\u95ee\u9898\u5bfc\u81f4\uff0c\u5de5\u827a\u6f02\u79fb\u662f\u7531\u4e8eEtch\u8fc7\u7a0b\u4e2d\u7684\u5316\u5b66\u53cd\u5e94\u4e0d\u7a33\u5b9a\u5bfc\u81f4\u7684\u3002"
    },
    "description": "\u57fa\u4e8e\u95ee\u9898\u91cd\u8ff0\uff0c\u63d0\u51fa3\u81f35\u4e2a\u6f5c\u5728\u7684\u6839\u56e0\u7c7b\u522b\uff0c\u5e2e\u52a9\u805a\u7126\u8c03\u67e5\u65b9\u5411\u3002"
  },
  "\u5b9a\u4e49\u95ee\u9898\u91cd\u8ff0": {
    "output": {
      "output": "Inline CD\u5f02\u5e38\u8d85\u8fc7\u4e0a\u63a7\u5236\u9650\uff0c\u5f71\u54cdProduct A\u7684Etch\u5de5\u827a\u8fc7\u7a0b\uff0c\u5bfc\u81f4\u54c1\u8d28\u95ee\u9898\u7684\u4ea7\u751f\u3002"
    },
    "description": "\u7528\u5de5\u7a0b\u4e13\u4e1a\u672f\u8bed\u51c6\u786e\u8868\u8ff0\u8d28\u91cf\u95ee\u9898\uff0c\u660e\u786e\u5f02\u5e38\u8868\u73b0\u53ca\u4e0e\u9884\u671f\u7684\u5dee\u5f02\uff0c\u4f5c\u4e3a\u8c03\u67e5\u57fa\u7840\u3002"
  },
  "\u6307\u5b9a\u68c0\u67e5\u6570\u636e": {
    "output": {
      "output": "\u9488\u5bf9\u6bcf\u4e2a\u6839\u56e0\u7c7b\u522b\uff0c\u9700\u91c7\u96c6\u7684\u6570\u636e\u7c7b\u578b\u5305\u62ec\uff1a\u8bbe\u5907\u6545\u969c\u4fe1\u606f\uff08Equipment\u6545\u969c\uff09\u3001\u539f\u6750\u6599\u8d28\u68c0\u62a5\u544a\uff08\u539f\u6750\u6599\u8d28\u91cf\u95ee\u9898\uff09\u548cEtch\u8fc7\u7a0b\u53c2\u6570\u53ca\u5316\u5b66\u53cd\u5e94\u6570\u636e\uff08Etch\u8fc7\u7a0b\u4e2d\u5316\u5b66\u53cd\u5e94\u4e0d\u7a33\u5b9a\u5bfc\u81f4\u7684\u5de5\u827a\u6f02\u79fb\uff09\u3002"
    },
    "description": "\u4e3a\u6bcf\u4e2a\u6839\u56e0\u7c7b\u522b\u6307\u5b9a\u9700\u8981\u6536\u96c6\u548c\u5206\u6790\u7684\u6570\u636e\u7c7b\u578b\u53ca\u6765\u6e90\uff0c\u652f\u6301\u540e\u7eed\u9a8c\u8bc1\u3002"
  },
  "\u89c4\u5212\u8c03\u67e5\u987a\u5e8f": {
    "output": {
      "output": "\u7efc\u4e0a\u6240\u8ff0\uff0c\u8c03\u67e5\u987a\u5e8f\u5e94\u4f18\u5148\u4f9d\u636e\u8bbe\u5907\u6545\u969c\u4fe1\u606f\uff08Equipment\u6545\u969c\uff09\u3001\u539f\u6750\u6599\u8d28\u68c0\u62a5\u544a\uff08\u539f\u6750\u6599\u8d28\u91cf\u95ee\u9898\uff09\u548cEtch\u8fc7\u7a0b\u53c2\u6570\u53ca\u5316\u5b66\u53cd\u5e94\u6570\u636e\uff08Etch\u8fc7\u7a0b\u4e2d\u5316\u5b66\u53cd\u5e94\u4e0d\u7a33\u5b9a\u5bfc\u81f4\u7684\u5de5\u827a\u6f02\u79fb\uff09\u3002\u6839\u636e\u95ee\u9898\u7c7b\u578b\uff08Yield drop\uff09\u548c\u4ea7\u54c1\uff08Product A\uff09\uff0c\u5e94\u91c7\u53d6\u4ee5\u4e0b\u8c03\u67e5\u987a\u5e8f\u548c\u51b3\u7b56\u70b9\uff1a\n1. \u8bbe\u5907\u6545\u969c\u4fe1\u606f\uff1a\u68c0\u67e5\u8bbe\u5907\u6545\u969c\u662f\u5426\u5bfc\u81f4Etch\u8fc7\u7a0b\u4e2d\u5316\u5b66\u53cd\u5e94\u4e0d\u7a33\u5b9a\u3002\n2. \u539f\u6750\u6599\u8d28\u68c0\u62a5\u544a\uff1a\u68c0\u67e5\u539f\u6750\u6599\u8d28\u91cf\u662f\u5426\u5f71\u54cd\u5de5\u827a\u7ed3\u679c\u3002\n3. Etch\u8fc7\u7a0b\u53c2\u6570\u53ca\u5316\u5b66\u53cd\u5e94\u6570\u636e\uff1a\u5206\u6790Etch\u8fc7\u7a0b\u53c2\u6570\u548c\u5316\u5b66\u53cd\u5e94\u6570\u636e\u662f\u5426\u5b58\u5728\u5f02\u5e38\u3002\n\u6839\u636e\u7ed3\u679c\u8c03\u6574\u8c03\u67e5\u65b9\u6848\uff1a\u6839\u636e\u8c03\u67e5\u7ed3\u679c\uff0c\u82e5\u8bbe\u5907\u6545\u969c\u4fe1\u606f\u663e\u793a\u5b58\u5728\u6545\u969c\u4e14\u5f71\u54cd\u5de5\u827a\u7ed3\u679c\uff0c\u5219\u5e94\u4f18\u5148\u68c0\u67e5\u8bbe\u5907\u6545\u969c\uff1b\u82e5\u539f\u6750\u6599\u8d28\u68c0\u62a5\u544a\u663e\u793a\u8d28\u91cf\u95ee\u9898\uff0c\u5e94\u4f18\u5148\u68c0\u67e5\u539f\u6750\u6599\u8d28\u68c0\u62a5\u544a\uff1b\u82e5Etch\u8fc7\u7a0b\u53c2\u6570\u53ca\u5316\u5b66\u53cd\u5e94\u6570\u636e\u663e\u793a\u5f02\u5e38\uff0c\u5e94\u4f18\u5148\u5206\u6790Etch\u8fc7\u7a0b\u53c2\u6570\u548c\u5316\u5b66\u53cd\u5e94\u6570\u636e\u3002"
    },
    "description": "\u8bbe\u8ba1\u8c03\u67e5\u6267\u884c\u7684\u903b\u8f91\u987a\u5e8f\u548c\u51b3\u7b56\u70b9\uff0c\u4f18\u5148\u4f4e\u6210\u672c\u4e14\u4fe1\u606f\u91cf\u5927\u7684\u68c0\u67e5\uff0c\u6307\u5bfc\u5177\u4f53\u5b9e\u65bd\u3002"
  }
