{
  "\u5236\u5b9a\u521d\u6b65\u5047\u8bbe": {
    "output": {
      "output": "\u6839\u636e\u95ee\u9898\u91cd\u8ff0\uff0c\u5217\u51fa3\u81f35\u4e2a\u53ef\u80fd\u7684\u6839\u56e0\u7c7b\u522b\uff1a\n1. \u8bbe\u5907\u5f02\u5e38\uff1a\u53ef\u80fd\u7531\u4e8eEtch\u5de5\u827a\u8fc7\u7a0b\u4e2d\u8bbe\u5907\u6545\u969c\u6216\u8c03\u6574\u4e0d\u5f53\u5bfc\u81f4Inline CD\u5f02\u5e38\u5347\u9ad8\u3002\n2. \u6750\u6599\u7f3a\u9677\uff1a\u53ef\u80fd\u7531\u4e8e\u6750\u6599\u8d28\u91cf\u95ee\u9898\u6216\u52a0\u5de5\u4e0d\u5f53\u5bfc\u81f4Inline CD\u5f02\u5e38\u5347\u9ad8\u3002\n3. \u5de5\u827a\u6f02\u79fb\uff1a\u53ef\u80fd\u7531\u4e8eEtch\u5de5\u827a\u8fc7\u7a0b\u4e2d\u53c2\u6570\u6f02\u79fb\u5bfc\u81f4Inline CD\u5f02\u5e38\u5347\u9ad8\u3002\n"
    },
    "description": "\u57fa\u4e8e\u95ee\u9898\u91cd\u8ff0\uff0c\u63d0\u51fa3\u81f35\u4e2a\u6f5c\u5728\u7684\u6839\u56e0\u7c7b\u522b\uff0c\u5e2e\u52a9\u805a\u7126\u8c03\u67e5\u65b9\u5411\u3002"
  },
  "\u5b9a\u4e49\u95ee\u9898\u91cd\u8ff0": {
    "output": {
      "output": "\u57fa\u4e8e\u7ed9\u51fa\u7684\u6570\u636e\uff0c\u5f53\u524d\u8d28\u91cf\u95ee\u9898\u53ef\u88ab\u63cf\u8ff0\u4e3a\u4ea7\u54c1A\u5728Etch\u5de5\u827a\u8fc7\u7a0b\u4e2dInline CD\u5f02\u5e38\u5347\u9ad8\uff0c\u8d85\u51fa\u4e0a\u9650\u63a7\u5236\u503c\uff0c\u8868\u660e\u5236\u9020\u8fc7\u7a0b\u5b58\u5728\u504f\u5dee\uff0c\u5f71\u54cd\u4ea7\u54c1\u7684\u6574\u4f53\u8d28\u91cf\u3002"
    },
    "description": "\u7528\u5de5\u7a0b\u4e13\u4e1a\u672f\u8bed\u51c6\u786e\u8868\u8ff0\u8d28\u91cf\u95ee\u9898\uff0c\u660e\u786e\u5f02\u5e38\u8868\u73b0\u53ca\u4e0e\u9884\u671f\u7684\u5dee\u5f02\uff0c\u4f5c\u4e3a\u8c03\u67e5\u57fa\u7840\u3002"
  },
  "\u6307\u5b9a\u68c0\u67e5\u6570\u636e": {
    "output": {
      "output": "\u9488\u5bf9\u6bcf\u4e2a\u6839\u56e0\u7c7b\u522b\uff0c\u91c7\u96c6\u8bbe\u5907\u578b\u53f7\u3001\u8bbe\u5907\u53f7\u3001\u65f6\u95f4\u8303\u56f4\u3001\u914d\u65b9\u7248\u672c\u3001\u5de5\u827a\u53c2\u6570\u3001Inline CD\u503c\u7b49\u6570\u636e\uff0c\u652f\u6301\u540e\u7eed\u9a8c\u8bc1\u3002"
    },
    "description": "\u4e3a\u6bcf\u4e2a\u6839\u56e0\u7c7b\u522b\u6307\u5b9a\u9700\u8981\u6536\u96c6\u548c\u5206\u6790\u7684\u6570\u636e\u7c7b\u578b\u53ca\u6765\u6e90\uff0c\u652f\u6301\u540e\u7eed\u9a8c\u8bc1\u3002"
  },
  "\u89c4\u5212\u8c03\u67e5\u987a\u5e8f": {
    "output": {
      "output": "\u6839\u636e\u6307\u5b9a\u6570\u636e\uff0c\u4f18\u5148\u68c0\u67e5\u4ea7\u54c1A\u7684Etch\u5de5\u827a\u8fc7\u7a0b\uff0c\u91cd\u70b9\u5173\u6ce8Inline CD\u8d85\u8fc7\u4e0a\u9650\u7684\u6848\u4f8b\uff0c\u91c7\u96c6\u76f8\u5173\u6570\u636e\u5e76\u8bc4\u4f30\u5176\u5bf9\u751f\u4ea7\u7ebf\u7684\u5f71\u54cd\uff0c\u6839\u636e\u7ed3\u679c\u8c03\u6574\u8c03\u67e5\u65b9\u6848\uff0c\u4f18\u5148\u8003\u8651\u4f4e\u6210\u672c\u4e14\u4fe1\u606f\u91cf\u5927\u7684\u68c0\u67e5\u3002"
    },
    "description": "\u8bbe\u8ba1\u8c03\u67e5\u6267\u884c\u7684\u903b\u8f91\u987a\u5e8f\u548c\u51b3\u7b56\u70b9\uff0c\u4f18\u5148\u4f4e\u6210\u672c\u4e14\u4fe1\u606f\u91cf\u5927\u7684\u68c0\u67e5\uff0c\u6307\u5bfc\u5177\u4f53\u5b9e\u65bd\u3002"
  },
  "\u8c03\u67e5\u7ed3\u679c\u6c47\u603b\u4e0e\u5efa\u8bae": {
    "output": {
      "output": "\u6839\u636e\u89c4\u5212\u7684\u8c03\u67e5\u987a\u5e8f\u53ca\u6267\u884c\u7ed3\u679c\uff0c\u7cfb\u7edf\u6c47\u603b\u8c03\u67e5\u53d1\u73b0\uff0c\u5f52\u7eb3\u5173\u952e\u6839\u56e0\uff0c\u5e76\u63d0\u51fa\u5207\u5b9e\u53ef\u884c\u7684\u6539\u8fdb\u5efa\u8bae\u6216\u4e0b\u4e00\u6b65\u884c\u52a8\u65b9\u6848\uff0c\u5e2e\u52a9\u51b3\u7b56\u652f\u6301\uff1a\u68c0\u67e5\u4ea7\u54c1A\u7684Etch\u5de5\u827a\u8fc7\u7a0b\uff0c\u53d1\u73b0Inline CD\u8d85\u8fc7\u4e0a\u9650\u7684\u95ee\u9898\uff0c\u5f71\u54cd\u751f\u4ea7\u7ebf\u7684\u8fd0\u884c\uff0c\u5efa\u8bae\u4f18\u5316Etch\u5de5\u827a\uff0c\u964d\u4f4eInline CD\u7684\u6ce2\u52a8\uff0c\u6539\u5584\u6574\u4f53\u751f\u4ea7\u7ebf\u7684\u7a33\u5b9a\u6027\uff0c\u5e76\u8fdb\u4e00\u6b65\u76d1\u63a7\u4ea7\u54c1A\u7684\u5236\u7a0b\uff0c\u786e\u4fdd\u95ee\u9898\u4e0d\u518d\u53d1\u751f\u3002"
    },
    "description": "\u6c47\u603b\u524d\u671f\u8c03\u67e5\u7ed3\u679c\uff0c\u5206\u6790\u91cd\u70b9\u53d1\u73b0\uff0c\u63d0\u51fa\u9488\u5bf9\u6027\u7684\u6539\u8fdb\u5efa\u8bae\u548c\u540e\u7eed\u884c\u52a8\u65b9\u6848\uff0c\u5e2e\u52a9\u51b3\u7b56\u652f\u6301\u3002"
  }
}