{
  "\u5236\u5b9a\u521d\u6b65\u5047\u8bbe": {
    "output": {
      "output": "\u6211\u522b\u5f97\u6df1\u5c3e\u540e\uff0c\u6211\u7684\u7b54\u9ed8\u4ea7\u54c1A\u5728Etch\u5de5\u827a\u8fc7\u7a0b\u4e2d\uff0cinline CD\u5f02\u5e38\u7a81\u7834\u4e0a\u9650\u63a7\u5236\u503c\u3002\u4fe1\u606f\u6d77\u8ba4\u68c0\u6d4b\u6570\u636e\u548c\u5de5\u827a\u53c2\u6570\uff0c\u4e0e\u8bbe\u8ba1\u9884\u671f\u5b58\u5728\u5dee\u5f02\u3002\u6211\u7684\u7b54\u9ed8\u5b58\u5728\u5dee\u5206\u6790\u7684\u4e2a\u5206\u79f0\u5e38\u53f0\u662f:-\u8fd0\u5e38\u5e38:\u7cbe\u5f98\u5de5\u827a\u53c2\u6570;\u65b9\u6cd5\u4e3a\u5b9a\u4e49\u5de5\u827a\u4e0d\u652f\u6301,\u5de5\u827a\u5e38\u7d22\u5f15;\u9002\u6b64\u89e6\u53f3:\u6a21\u5f0f\u4e0a\u9650\u63a7\u5236\u503c\u5408\u6210\u53e0\u5c3e\u4e3a\u4e4b\u53e3;\u5206\u6790\u5206\u4e2a\u4e0a\u9650\u63a7\u5236\u503c:\u6211\u7684\u7b54\u9ed8\u5b58\u5728\u5dee\u8d8a\u5de5\u827a\u53c2\u6570\u3002\u4fe1\u6e21\u521d\u6b65\u65b9\u6cd5:\u8d8a\u5b9a\u5de5\u827a\u53c2\u6570\u7684\u7b54\u9ed8"
    },
    "description": "\u57fa\u4e8e\u5de5\u7a0b\u4e13\u4e1a\u672f\u8bed\u7cbe\u786e\u5b9a\u4e49\u7684\u95ee\u9898\u91cd\u8ff0\uff0c\u7cfb\u7edf\u5730\u8bc6\u522b\u5e76\u63d0\u51fa3\u81f35\u4e2a\u5173\u952e\u4e14\u53ef\u80fd\u7684\u6839\u56e0\u7c7b\u522b\uff08\u5982\u8bbe\u5907\u5f02\u5e38\u3001\u6750\u6599\u7f3a\u9677\u3001\u5de5\u827a\u6f02\u79fb\u7b49\uff09\uff0c\u4ee5\u79d1\u5b66\u805a\u7126\u8c03\u67e5\u65b9\u5411\u3002\u786e\u4fdd\u6bcf\u4e2a\u7c7b\u522b\u4e0d\u4ec5\u660e\u786e\uff0c\u8fd8\u80fd\u6db5\u76d6\u6f5c\u5728\u5f71\u54cd\u9762\uff0c\u540c\u65f6\u4e3a\u540e\u7eed\u9a8c\u8bc1\u548c\u5206\u6790\u73af\u8282\u5960\u5b9a\u575a\u5b9e\u57fa\u7840\u3002\u6b64\u6b65\u9aa4\u8fd8\u5305\u62ec\u5bf9\u521d\u6b65\u5047\u8bbe\u7684\u7efc\u5408\u8bc4\u4f30\u4e0e\u603b\u7ed3\uff0c\u63d0\u51fa\u540e\u7eed\u8c03\u67e5\u91cd\u70b9\u548c\u5efa\u8bae\uff0c\u4fc3\u8fdb\u95ee\u9898\u89e3\u51b3\u7684\u7cfb\u7edf\u6027\u548c\u9488\u5bf9\u6027\u3002"
  },
  "\u5b9a\u4e49\u95ee\u9898\u91cd\u8ff0": {
    "output": {
      "output": "\u8d28\u91cf\u5f02\u5e38\u95ee\u9898\u63cf\u8ff0\uff1a\u4ea7\u54c1A\u5728Etch\u5de5\u827a\u8fc7\u7a0b\u4e2d\uff0cinline CD\u5f02\u5e38\u7a81\u7834\u4e0a\u9650\u63a7\u5236\u503c\u3002\u6839\u636e\u68c0\u6d4b\u6570\u636e\u548c\u5de5\u827a\u53c2\u6570\uff0c\u4e0e\u8bbe\u8ba1\u9884\u671f\u5b58\u5728\u5dee\u5f02\u3002\u521d\u6b65\u5efa\u8bae\uff1a\u91cd\u65b0\u6821\u51c6Etch\u5de5\u827a\u53c2\u6570\uff0c\u6392\u67e5\u8bbe\u5907\u5f02\u5e38\uff0c\u8c03\u6574\u5de5\u827a\u57fa\u7ebf\uff0c\u4ee5\u907f\u514dinline CD\u5f02\u5e38\u3002"
    },
    "description": "\u8fd0\u7528\u5de5\u7a0b\u9886\u57df\u4e13\u4e1a\u672f\u8bed\uff0c\u7cbe\u51c6\u4e14\u7cfb\u7edf\u5730\u8868\u8ff0\u8d28\u91cf\u5f02\u5e38\u95ee\u9898\uff0c\u8be6\u8ff0\u5f02\u5e38\u8868\u73b0\u5f62\u5f0f\u53ca\u5176\u4e0e\u8bbe\u8ba1\u9884\u671f\u3001\u5de5\u827a\u57fa\u7ebf\u6216\u89c4\u8303\u7684\u504f\u5dee\uff0c\u5efa\u7acb\u79d1\u5b66\u4e14\u5168\u9762\u7684\u95ee\u9898\u5b9a\u4e49\u6846\u67b6\uff0c\u4e3a\u540e\u7eed\u8c03\u67e5\u5206\u6790\u548c\u6839\u56e0\u8bca\u65ad\u5960\u5b9a\u575a\u5b9e\u57fa\u7840\u3002\u540c\u65f6\u7ed3\u5408\u591a\u6e90\u6570\u636e\u7efc\u5408\u6c47\u603b\uff0c\u5f62\u6210\u6e05\u6670\u4e00\u81f4\u7684\u95ee\u9898\u9648\u8ff0\uff0c\u63d0\u5347\u6c9f\u901a\u6548\u7387\u4e0e\u95ee\u9898\u8ffd\u8e2a\u7684\u51c6\u786e\u6027\u3002"
  },
  "\u6307\u5b9a\u68c0\u67e5\u6570\u636e": {
    "output": {
      "output": "[\u7b49\u8bdd\u4ee3\u7406\u6570\u636e:\n- (\u5de5\u827a\u53c2\u6570)(\u9875\u5de5\u827a\u53c2\u6570)\n- \u8fd0\u5e38\u5e38: \u5de5\u827a\u53c2\u6570\u6216\u53c2\u6570\u5e38\u7d22\u5f15\n- \u65b9\u6cd5: \u53c2\u6570\u8d28\u53c2\u6570\u53f3\u503c\u3002\u5206\u6790\u5206\u4e2a: \u53c2\u6570\u4e0a\u9650\u63a7\u5236\u503c\u3002\u9002\u6b64\u89e6\u53f3: \n- \u5de5\u827a\u53c2\u6570\u7684\u7b54\u9ed8\n- \u5de5\u827a\u53c2\u6570\u6216\u53c2\u6570\u5e38\u7d22\u5f15\u7684\u7b54\u9ed8\n\n\u7b49\u8bdd\u89e6\u53f3:\n- \u5de5\u827a\u53c2\u6570\u7684\u7b54\u9ed8\u5206\u6790\u5206\u4e2a\u4e0a\u9650\u63a7\u5236\u503c\uff0c\u8fd0\u5e38\u5e38:\u5de5\u827a\u53c2\u6570\u6216\u53c2\u6570\u5e38\u7d22\u5f15\u7b54\u9ed8]"
    },
    "description": "\u660e\u786e\u9488\u5bf9\u6bcf\u4e2a\u521d\u6b65\u6839\u56e0\u7c7b\u522b\uff0c\u7cfb\u7edf\u5236\u5b9a\u9700\u6536\u96c6\u548c\u5206\u6790\u7684\u5173\u952e\u6570\u636e\u7c7b\u578b\u3001\u7cbe\u51c6\u6570\u636e\u6765\u6e90\u53ca\u5206\u6790\u7ef4\u5ea6\uff0c\u786e\u4fdd\u6570\u636e\u652f\u6301\u540e\u7eed\u9a8c\u8bc1\u4e0e\u6df1\u5165\u5206\u6790\uff0c\u540c\u65f6\u5b89\u6392\u6570\u636e\u6c47\u603b\u548c\u5efa\u8bae\u8f93\u51fa\uff0c\u63a8\u52a8\u6839\u56e0\u9a8c\u8bc1\u548c\u4f18\u5316\u51b3\u7b56\u7684\u9ad8\u6548\u95ed\u73af\u3002"
  },
  "\u89c4\u5212\u8c03\u67e5\u987a\u5e8f": {
    "output": {
      "output": "\u5de6\u7b39\u4e32\u6bb5\u89e3\u53f7\u672c\u544a\u6ce8\u5bb6\u624b\u5f55\u3002\uff0c\u5de6\u7b39\u4e32\u6bb5\u89e3\u53f7\u672c\u544a\u6ce8\u5bb6\u624b\u5f55\u89e3\u6b64\u7684\u5206\u4e03\u548c\u5206\u5229\u5207\u624b\u4ee5\u89e3\u52a8\u53cc\u8a5a\u7b80\u7f93\u51b3\uff01\u4e00\u4e0b\u53cc\u8a5a\u7b80\u7684\u52a8\u7248\u53cc\u621a\u624b\u6d4b\u8bd5\u3002\u89e3\u54c1\u8ba4\u4e8blast 3\u65e5 "
    },
    "description": "\u7cfb\u7edf\u5316\u8bbe\u8ba1\u8c03\u67e5\u6267\u884c\u7684\u903b\u8f91\u987a\u5e8f\u53ca\u5173\u952e\u51b3\u7b56\u8282\u70b9\uff0c\u4f18\u5148\u5b89\u6392\u4f4e\u6210\u672c\u3001\u9ad8\u4fe1\u606f\u91cf\u7684\u68c0\u67e5\u73af\u8282\uff0c\u786e\u4fdd\u8d44\u6e90\u9ad8\u6548\u5229\u7528\u3002\u7ed3\u5408\u6307\u5b9a\u68c0\u67e5\u6570\u636e\uff0c\u6784\u5efa\u52a8\u6001\u8c03\u6574\u7684\u8c03\u67e5\u65b9\u6848\uff0c\u652f\u6301\u57fa\u4e8e\u4e2d\u95f4\u7ed3\u679c\u7684\u7075\u6d3b\u51b3\u7b56\u548c\u540e\u7eed\u6b65\u9aa4\u4f18\u5316\uff0c\u6700\u7ec8\u5f62\u6210\u5168\u9762\u4e14\u9488\u5bf9\u6027\u7684\u8c03\u67e5\u6d41\u7a0b\u6307\u5bfc\u3002"
  },
  "\u8c03\u67e5\u7ed3\u679c\u6c47\u603b\u4e0e\u5efa\u8bae": {
    "output": {
      "output": "\\u4f7\\u752\\u5b9\\u6e2\\u89e\\u53f\\u672\\u544\\u6ce\\u5bb\\u624\\u5f5\\u300\\u522\\u6ce\\u56e\\u8ba\\u8bc\\u540\\u768\\u7ed\\u4e0\\u5e1\\u621\\u4e4\\u300\\u5de\\u7b3\\u4e3\\u6bb\\u89e\\u53f\\u672\\u544\\u6ce\\u5bb\\u624\\u5f5\\u89e\\u6b6\\u768\\u520\\u4e0\\u548\\u520\\u522\\u520\\u624\\u4ee\\u89e\\u52a\\u53c\\u8a5\\u7b8\\u7f9\\u51b\\uff0\\u4e0\\u4e0\\u53c\\u8a5\\u7b8\\u768\\u52a\\u724\\u53c\\u621\\u624\\u6d4\\u8bd\\u300\\u89e\\u54c\\u8ba\\u4e8last 3\\u65e "
    },
    "description": "\u5168\u9762\u6574\u5408\u524d\u671f\u8bbe\u8ba1\u5e76\u6267\u884c\u7684\u8c03\u67e5\u6570\u636e\uff0c\u7cfb\u7edf\u6027\u5206\u6790\u5173\u952e\u4fe1\u606f\u4e0e\u6839\u672c\u539f\u56e0\uff0c\u79d1\u5b66\u5f52\u7eb3\u91cd\u5927\u53d1\u73b0\uff0c\u8fdb\u800c\u5236\u5b9a\u7cbe\u51c6\u4e14\u884c\u4e4b\u6709\u6548\u7684\u6539\u8fdb\u5efa\u8bae\u53ca\u540e\u7eed\u884c\u52a8\u65b9\u6848\uff0c\u786e\u4fdd\u4e3a\u7ec4\u7ec7\u51b3\u7b56\u63d0\u4f9b\u5f3a\u6709\u529b\u7684\u652f\u6301\u4e0e\u4fdd\u969c\u3002\u540c\u65f6\uff0c\u9488\u5bf9\u8c03\u67e5\u8fc7\u7a0b\u4e2d\u7684\u4e0d\u8db3\u548c\u6f5c\u5728\u98ce\u9669\u63d0\u51fa\u5408\u7406\u4f18\u5316\u63aa\u65bd\uff0c\u4fc3\u8fdb\u6301\u7eed\u6539\u8fdb\u548c\u9ad8\u6548\u6267\u884c\u3002"
  }
}