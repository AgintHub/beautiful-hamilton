  "\u89c4\u5212\u8c03\u67e5\u987a\u5e8f": {
    "output": {
      "output": "{\"description\":\"\u7cfb\u7edf\u5316\u8bbe\u8ba1\u8c03\u67e5\u6267\u884c\u7684\u903b\u8f91\u987a\u5e8f\u53ca\u5173\u952e\u51b3\u7b56\u8282\u70b9\u4f18\u5148\u5b89\u6392\u4f4e\u6210\u672c\u9ad8\u4fe1\u606f\u91cf\u7684\u68c0\u67e5\u73af\u8282\u786e\u4fdd\u8d44\u6e90\u9ad8\u6548\u5229\u7528\u7ed3\u5408\u6307\u5b9a\u68c0\u67e5\u6570\u636e\u6784\u5efa\u52a8\u6001\u8c03\u6574\u7684\u8c03\u67e5\u65b9\u6848\u652f\u6301\u57fa\u4e8e\u4e2d\u95f4\u7ed3\u679c\u7684\u7075\u6d3b\u51b3\u7b56\u548c\u540e\u7eed\u6b65\u9aa4\u4f18\u5316\u6700\u7ec8\u5f62\u6210\u5168\u9762\u4e14\u9488\u5bf9\u6027\u7684\u8c03\u67e5\u6d41\u7a0b\u6307\u5bfc\"}"
    },
    "description": "\u7cfb\u7edf\u5316\u8bbe\u8ba1\u8c03\u67e5\u6267\u884c\u7684\u903b\u8f91\u987a\u5e8f\u53ca\u5173\u952e\u51b3\u7b56\u8282\u70b9\uff0c\u4f18\u5148\u5b89\u6392\u4f4e\u6210\u672c\u3001\u9ad8\u4fe1\u606f\u91cf\u7684\u68c0\u67e5\u73af\u8282\uff0c\u786e\u4fdd\u8d44\u6e90\u9ad8\u6548\u5229\u7528\u3002\u7ed3\u5408\u6307\u5b9a\u68c0\u67e5\u6570\u636e\uff0c\u6784\u5efa\u52a8\u6001\u8c03\u6574\u7684\u8c03\u67e5\u65b9\u6848\uff0c\u652f\u6301\u57fa\u4e8e\u4e2d\u95f4\u7ed3\u679c\u7684\u7075\u6d3b\u51b3\u7b56\u548c\u540e\u7eed\u6b65\u9aa4\u4f18\u5316\uff0c\u6700\u7ec8\u5f62\u6210\u5168\u9762\u4e14\u9488\u5bf9\u6027\u7684\u8c03\u67e5\u6d41\u7a0b\u6307\u5bfc\u3002"
  },
  "\u8c03\u67e5\u7ed3\u679c\u6c47\u603b\u4e0e\u5efa\u8bae": {
    "output": {
      "output": "{\"description\":\"\u57fa\u4e8e\u89c4\u5212\u7684\u8c03\u67e5\u987a\u5e8f\u548c\u6267\u884c\u7ed3\u679c\uff0c\u7cfb\u7edf\u68b3\u7406\u5e76\u6c47\u603b\u6240\u6709\u8c03\u67e5\u6570\u636e\uff0c\u6df1\u5165\u5206\u6790\u5173\u952e\u6839\u56e0\u548c\u6838\u5fc3\u53d1\u73b0\uff0c\u51c6\u786e\u63d0\u70bc\u91cd\u70b9\u95ee\u9898\u3002\u7efc\u5408\u8c03\u67e5\u590d\u6742\u5ea6\u4e0e\u5f71\u54cd\u7a0b\u5ea6\uff0c\u63d0\u51fa\u5207\u5b9e\u53ef\u884c\u3001\u4f18\u5148\u5ea6\u660e\u786e\u7684\u6539\u8fdb\u5efa\u8bae\u548c\u4e0b\u4e00\u6b65\u884c\u52a8\u65b9\u6848\uff0c\u660e\u786e\u8d23\u4efb\u4eba\u548c\u65f6\u95f4\u8282\u70b9\u3002\u540c\u65f6\u5bf9\u8c03\u67e5\u6d41\u7a0b\u8fdb\u884c\u8bc4\u4f30\uff0c\u8bc6\u522b\u4f18\u5316\u7a7a\u95f4\u548c\u6f5c\u5728\u98ce\u9669\uff0c\u7ed9\u51fa\u79d1\u5b66\u7684\u6d41\u7a0b\u5b8c\u5584\u5efa\u8bae\uff0c\u52a9\u529b\u540e\u7eed\u63aa\u65bd\u66f4\u9ad8\u6548\u3001\u66f4\u5177\u9488\u5bf9\u6027\u5730\u5b9e\u65bd\u3002\"}"
    },
    "description": "\u5168\u9762\u6574\u5408\u524d\u671f\u8bbe\u8ba1\u5e76\u6267\u884c\u7684\u8c03\u67e5\u6570\u636e\uff0c\u7cfb\u7edf\u6027\u5206\u6790\u5173\u952e\u4fe1\u606f\u4e0e\u6839\u672c\u539f\u56e0\uff0c\u79d1\u5b66\u5f52\u7eb3\u91cd\u5927\u53d1\u73b0\uff0c\u8fdb\u800c\u5236\u5b9a\u7cbe\u51c6\u4e14\u884c\u4e4b\u6709\u6548\u7684\u6539\u8fdb\u5efa\u8bae\u53ca\u540e\u7eed\u884c\u52a8\u65b9\u6848\uff0c\u786e\u4fdd\u4e3a\u7ec4\u7ec7\u51b3\u7b56\u63d0\u4f9b\u5f3a\u6709\u529b\u7684\u652f\u6301\u4e0e\u4fdd\u969c\u3002\u540c\u65f6\uff0c\u9488\u5bf9\u8c03\u67e5\u8fc7\u7a0b\u4e2d\u7684\u4e0d\u8db3\u548c\u6f5c\u5728\u98ce\u9669\u63d0\u51fa\u5408\u7406\u4f18\u5316\u63aa\u65bd\uff0c\u4fc3\u8fdb\u6301\u7eed\u6539\u8fdb\u548c\u9ad8\u6548\u6267\u884c\u3002"
  }
